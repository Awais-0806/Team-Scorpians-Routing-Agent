# Hugging Face Token (for Gemma model weights)
HF_TOKEN=hf_your_huggingface_read_token_here

# Fireworks AI API Key
FIREWORKS_API_KEY=fw_your_fireworks_api_key_here

# Fireworks Model ID
FIREWORKS_MODEL=accounts/fireworks/models/gemma-4-31b-it

# Local Model (vLLM)
LOCAL_MODEL=google/gemma-4-e4b-it

# Router Configuration
CONFIDENCE_THRESHOLD=0.6
SELF_CONSISTENCY_SAMPLES=3